---
import Base from '../layouts/Base.astro';
import { site } from '../site';

const year = new Date().getFullYear();
---

<Base title="Page not found" description="This page does not exist." noindex>
  <header class="site-header wrap">
    <a class="brand" href="/">{site.shortName}</a>
  </header>

  <main id="main" class="not-found wrap">
    <h1>This page doesn't exist.</h1>
    <p class="lede">
      The link may be old or mistyped. Start from the home page, or email me if you were looking for
      something specific.
    </p>
    <p class="actions">
      <a class="btn" href="/">Go to the home page</a>
      <a href={`mailto:${site.email}`}>Email me</a>
    </p>
  </main>

  <footer class="site-footer wrap">
    <p>&copy; {year} {site.name}. {site.location}.</p>
  </footer>
</Base>
